# Instagram DM bot. Copy to .env for local runs, or set these as Railway variables.
# Blank values count as unset. Never commit .env (it is gitignored).

# ── Safety switches ─────────────────────────────────────────────────────────
# true = everything runs except the three send calls (intro DM, link DM, public reply).
DRY_RUN=true
# Comma-separated Instagram usernames. When set, ONLY these people get DMs
# (use your Instagram Tester accounts until App Review is approved).
ALLOWLIST=
# Public "check your DMs" replies under triggering comments. Also needs "publicReply": true on the trigger.
PUBLIC_REPLIES_ENABLED=false

# ── Meta app ────────────────────────────────────────────────────────────────
# App Dashboard → Instagram → API setup with Instagram login → Business login settings.
IG_APP_ID=
IG_APP_SECRET=
# Optional. App settings → Basic → App secret. Accepted as a second webhook-signing secret.
META_APP_SECRET=
# Any long random string. Paste the same value into App Dashboard → Webhooks → Verify token.
WEBHOOK_VERIFY_TOKEN=
# The only Instagram account allowed to connect (without @).
EXPECTED_IG_USERNAME=
# Optional seed: a long-lived token from "Generate token" in the dashboard. After first boot the bot
# keeps and refreshes its own copy in the database (or connect via /auth/login instead).
IG_ACCESS_TOKEN=
GRAPH_VERSION=v26.0

# ── Server ──────────────────────────────────────────────────────────────────
# Public origin, no trailing slash, e.g. https://ig-dm-bot-production.up.railway.app
PUBLIC_BASE_URL=
# At least 24 characters. Protects /health, /admin and the npm scripts (Bearer token, or Basic-auth password).
ADMIN_TOKEN=
PORT=3000
DATA_DIR=./data
TRIGGERS_PATH=./triggers.json
LOG_LEVEL=info
# Your time zone, for the "today" counts in /health (e.g. America/New_York, Europe/London).
REPORT_TZ=Asia/Tokyo

# ── Pacing and Meta's windows ───────────────────────────────────────────────
DM_HOURLY_CAP=190
PUBLIC_REPLY_HOURLY_CAP=30
PRIVATE_REPLY_MAX_AGE_H=166
LINK_WINDOW_MARGIN_MIN=30
# primary = poll comments every minute (before App Review) · backup = slow safety net once
# comment webhooks flow · off
POLL_PROFILE=primary
# Only comments after this instant can trigger. Default: the first boot. ISO date.
BACKFILL_SINCE=
LEAD_RETENTION_DAYS=365

# ── Notion lead mirror (optional) ───────────────────────────────────────────
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=

# ── Alerts and privacy page (optional) ──────────────────────────────────────
# A Discord or Slack webhook URL, or an ntfy.sh topic URL.
ALERT_WEBHOOK_URL=
# Contact line shown on /privacy and /data-deletion (default: "a DM to @<username>").
PRIVACY_CONTACT=

# ── npm scripts (report, leads:export, subscribe, simulate) ─────────────────
# Which running bot to talk to; defaults to PUBLIC_BASE_URL, then http://localhost:$PORT.
BOT_URL=
