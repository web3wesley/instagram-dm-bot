{
  "name": "ig-dm-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Instagram comment-to-DM bot for one Creator account (Instagram API with Instagram Login).",
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/main.ts | pino-pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run typecheck && npm test",
    "simulate": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/simulate.ts",
    "subscribe": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/subscribe.ts",
    "leads:export": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/export-leads.ts",
    "report": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/report.ts",
    "status": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/status-report.ts"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
